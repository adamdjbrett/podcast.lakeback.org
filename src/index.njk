{% set m = metadata -%}
<!doctype html>
<html lang="{{ m.lang | escape }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ m.title | escape }} · {{ m.format | escape }}</title>
  <meta name="description" content="{{ m.description | escape }}">
  <link rel="canonical" href="{{ m.url | escape }}">
  <meta property="og:title" content="{{ m.title | escape }}">
  <meta property="og:description" content="{{ m.description | escape }}">
  <meta property="og:image" content="{{ m.url | escape }}{{ m.cover.path.slice(1) | escape }}">
  <link rel="icon" type="image/webp" href="{{ m.favicon | escape }}">
  <link rel="apple-touch-icon" sizes="180x180" href="{{ m.appleTouchIcon | escape }}">
  <link rel="stylesheet" href="/assets/site.css">
  <script defer src="/assets/countdown.js"></script>
</head>
<body>
  <header class="mast">
    <div class="wrap mast-inner">
      <a class="brand" href="/" aria-current="page">
        <img src="{{ m.logo | escape }}" alt="" width="192" height="192">
        <span>{{ m.title | escape }}</span>
      </a>
      <div class="place"><span class="route-line" aria-hidden="true"><i></i><i></i><i></i></span>{{ m.place }}</div>
    </div>
  </header>
  <main class="wrap">
    <section class="poster" aria-labelledby="title">
      <div>
        <p class="signal micro"><span aria-hidden="true"></span>{{ m.status }}</p>
        <h1 id="title">{{ m.title | escape }}</h1>
        <p class="subtitle">{{ m.subtitle | escape }}</p>
      </div>
      <figure>
        <img src="{{ m.cover.path | escape }}" width="760" height="760" alt="{{ m.cover.alt | escape }}">
        <figcaption>{{ m.cover.credit }} · <a href="{{ m.cover.licenseUrl }}">{{ m.cover.license }}</a></figcaption>
      </figure>
    </section>
    <section class="board" aria-labelledby="board-heading">
      <div class="board-cap"><h2 id="board-heading">{{ m.launch.heading }}</h2><span class="grille" aria-hidden="true"></span></div>
      <div class="readout">
        <div class="schedule">
          <p class="micro">{{ m.launch.label }}</p>
          <time datetime="{{ m.launch.at }}"><strong>{{ m.launch.at | schedule(m.launch.zone, "date") }}</strong><span>{{ m.launch.at | schedule(m.launch.zone, "time") }} · {{ m.launch.zoneLabel }}</span></time>
        </div>
        <div class="clock" role="timer" aria-label="{{ m.launch.countdownLabel }}" hidden>
          {% for unit in m.launch.units -%}
          <div><b data-digit>00</b><span class="micro">{{ unit }}</span></div>
          {% endfor -%}
        </div>
        <p class="arrived" hidden>{{ m.launch.arrived }}</p>
      </div>
    </section>
  </main>
  <footer class="wrap"><a href="{{ m.publisherUrl }}">{{ m.publisher }} <span aria-hidden="true">↗</span></a><a href="{{ m.campaignUrl }}">{{ m.campaign }} <span aria-hidden="true">↗</span></a></footer>
</body>
</html>
