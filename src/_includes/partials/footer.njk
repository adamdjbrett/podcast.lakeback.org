<footer class="site-footer p-s-m">
  <div class="wrapper">
    {% include 'partials/theme-switch.njk' %}

    <p class="site-footer__colophon">{{ home.footer.colophon }}</p>
    <p class="site-footer__colophon">
      {{ meta.license.label }}
      <a class="no-indicator" rel="license" href="{{ meta.license.url }}">{% svg meta.license.icon, "", "", "inline-size: 88px; block-size: 31px; vertical-align: middle" %} {{ meta.license.name }}</a>
    </p>

    <div class="cluster gutter-xs">
      <nav class="cluster text-step-0" aria-label="{{ meta.navigation.ariaBottom }}">
        {# the publisher's h-card #}
        <span class="h-card">&copy; {% year %} <a class="p-name p-org u-url no-indicator" rel="me" href="{{ meta.author.website }}">{{ meta.author.name }}</a><a class="u-url u-uid" href="{{ meta.url }}/" hidden>{{ meta.author.name }}</a><a class="u-email" href="mailto:{{ meta.author.email }}" hidden>{{ meta.author.email }}</a></span>
        <a class="no-indicator" href="{{ meta.links.lakeback }}">{{ meta.links.lakeback | host }}</a>
        {% for item in navigation.bottom %}
          <a href="{{ item.url }}" {{ helpers.getLinkActiveState(item.url, page.url) | safe }}>{{ item.text }}</a>
        {% endfor %}
        <a href="{{ meta.podcast.feed }}" rel="alternate" type="application/rss+xml" class="button" data-icon>
          <span class="visually-hidden">{{ meta.feeds[0].title }}</span>
          {% svg "phosphor/rss" %}
        </a>
      </nav>
    </div>
  </div>
</footer>
