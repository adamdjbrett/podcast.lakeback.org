---
layout: base
---

<article class="h-entry | region wrapper flow prose" style="--region-space-top: var(--space-xl-2xl)">
  <h1 class="p-name">{{ title }}</h1>
  <a class="u-url u-uid" href="{{ meta.url }}{{ page.url }}" hidden>{{ title }}</a>
  <a class="p-author h-card" href="{{ meta.author.website }}" rel="author" hidden>{{ meta.author.name }}</a>
  <div class="e-content | flow">{{ content | safe }}</div>
</article>
