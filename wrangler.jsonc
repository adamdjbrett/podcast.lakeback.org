{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "podcast-lakeback-org",
  "compatibility_date": "2026-11-21",
  "assets": { "directory": "./dist", "not_found_handling": "404-page" },
  "workers_dev": false,
  "routes": [
    { "pattern": "podcast.lakeback.org", "custom_domain": true }
  ]
}
